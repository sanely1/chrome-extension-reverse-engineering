  "workflows": [
    {
      "name": "Initial Page Load and UI Injection",
      "triggers": [
        "User navigates to a new page"
      ],
      "steps": [
        "Content script is injected.",
        "It messages the service worker to check if the current website is supported.",
        "Service worker calls the Faircado API to get the site's status and data extraction configuration (selectors or metadata).",
        "Based on the mode, the content script extracts product data from the DOM or from structured data (JSON-LD, etc.).",
        "If an A/B test is active, a 'catalogue redirector' UI is shown; otherwise, an iframe for the embedded or popup view is prepared.",
        "A separate script is injected to monitor SPA navigation events."
      ],
      "apis": [
        "chrome.runtime.sendMessage",
        "fetch"
      ],
      "messages": [
        "isSupportedWebsite",
        "getHeuristicData"
      ],
      "endpoints": [
        "https://catalog-service-api.faircado.com/api/v1/supported-website"
      ],
      "storage_keys": [],
      "evidence": [
        {
          "file": "extension/content.js",
          "start": 11981,
          "end": 12065
        },
        {
          "file": "extension/background.js",
          "start": 688,
          "end": 714
        }
      ]
    },
    {
      "name": "Manual Extension Activation (Icon Click)",
      "triggers": [
        "User clicks the extension's toolbar icon"
      ],
      "steps": [
        "Service worker's icon click listener is triggered.",
        "It checks for data consent; if missing, it opens the consent page.",
        "It sends a 'showExtension' message to the content script.",
        "The content script forces the data extraction process.",
        "The UI iframe is made visible.",
        "Page data is sent to the iframe via `postMessage` to populate the search."
      ],
      "apis": [
        "chrome.action.onClicked",
        "chrome.tabs.sendMessage"
      ],
      "messages": [
        "showExtension",
        "openOnFullMode"
      ],
      "endpoints": [],
      "storage_keys": [],
      "evidence": [
        {
          "file": "extension/background.js",
          "start": 614,
          "end": 628
        },
        {
          "file": "extension/content.js",
          "start": 12327,
          "end": 12356
        }
      ]
    },
    {
      "name": "Data Consent and Uninstallation",
      "triggers": [
        "User opens data-control.html page"
      ],
      "steps": [
        "User clicks the 'activate' button.",
        "An 'activated' flag is stored in localStorage.",
        "The script retrieves the unique `machineKey`.",
        "The user is redirected to a post-install URL with the `machineKey` for tracking.",
        "Alternatively, the user clicks the 'uninstall' button, which triggers the extension to uninstall itself."
      ],
      "apis": [
        "browser.management.uninstallSelf",
        "localStorage.setItem"
      ],
      "messages": [],
      "endpoints": [
        "https://faircado.com/after-extension-install-versioned"
      ],
      "storage_keys": [
        "activated"
      ],
      "evidence": [
        {
          "file": "extension/data-control.js",
          "start": 306,
          "end": 316
        }
      ]
    }
  ],
  "privacy": {
    "data_categories": [
      "unique_user_identifier",
      "browsing_activity",
      "analytics_telemetry"
    ],
    "purposes": [
      "core_functionality",
      "analytics_tracking",
      "user_onboarding"
    ],
    "minimization": "The extension collects a persistent unique identifier (machineKey) for analytics, which is not strictly necessary for its core product-finding functionality. It also has broad host permissions and reads the entire page DOM for metadata parsing.",
    "consent": "Consent is handled via an explicit 'activate' button on a data control page for Firefox users. For other browsers, consent appears to be implicit upon installation, with no observed opt-out mechanism for tracking.",
    "retention": "The unique 'machineKey' and A/B test assignments are stored indefinitely. API data is cached with a time-based expiration.",
    "third_parties": [
